package com.CasinoCtC.CCtCAPI.service;

import java.util.List;
import java.util.stream.Collectors;

import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.stereotype.Service;

import com.CasinoCtC.CCtCAPI.dao.UserDAO;
import com.CasinoCtC.CCtCAPI.model.User;

@Service
public class UserServiceImpl implements UserService {

    private final UserDAO userDAO;
    private final PasswordEncoder passwordEncoder;

    public UserServiceImpl(
            UserDAO userDAO,
            PasswordEncoder passwordEncoder) {
        this.userDAO = userDAO;
        this.passwordEncoder = passwordEncoder;
    }

    @Override
    public List<User> getAllUsers() {
        return userDAO.findAll().stream()
            .map(this::sanitizeUser)
            .collect(Collectors.toList());
    }

    @Override
    public User getUserById(int id) {
        return userDAO.findById(id)
            .map(this::sanitizeUser)
            .orElse(null);
    }

    @Override
    public User saveUser(User user) {
        User toSave = new User();
        toSave.setUserId(user.getUserId());
        toSave.setUserName(user.getUserName());
        toSave.setLocationId(user.getLocationId());
        toSave.setStatus(user.getStatus());

        User existing = userDAO.findById(user.getUserId()).orElse(null);

        if (existing == null) {
            // new user -> password required
            if (user.getPassword() == null || user.getPassword().trim().isEmpty()) {
                throw new RuntimeException("Password is required for a new user");
            }
            toSave.setPassword(passwordEncoder.encode(user.getPassword().trim()));
        } else {
            // existing user -> keep existing password if blank
            if (user.getPassword() == null || user.getPassword().trim().isEmpty()) {
                toSave.setPassword(existing.getPassword());
            } else {
                toSave.setPassword(passwordEncoder.encode(user.getPassword().trim()));
            }
        }

        User saved = userDAO.save(toSave);
        return sanitizeUser(saved);
    }

    @Override
    public void deleteUser(int id) {
        userDAO.deleteById(id);
    }

    private User sanitizeUser(User user) {
        if (user == null) return null;

        User clean = new User();
        clean.setUserId(user.getUserId());
        clean.setUserName(user.getUserName());
        clean.setPassword(""); // never send hashed password to UI
        clean.setLocationId(user.getLocationId());
        clean.setStatus(user.getStatus());
        return clean;
    }
}